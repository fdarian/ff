{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"check": {
			"dependsOn": ["check:type", "check:lint"]
		},
		"check:type": {},
		"check:lint": {},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"test": {},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
