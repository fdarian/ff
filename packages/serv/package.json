{
	"name": "ff-serv",
	"version": "0.2.0",
	"type": "module",
	"bin": {
		"ff-serv": "./dist/cli.js"
	},
	"exports": {
		".": "./src/index.ts",
		"./orpc": "./src/exports/orpc.ts",
		"./cache": "./src/exports/cache.ts",
		"./cache/ioredis": "./src/exports/cache-ioredis.ts",
		"./cache/bun-redis": "./src/exports/cache-bun-redis.ts"
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown && bun run build:cli",
		"build:cli": "bun build src/cli/index.ts --production --target=bun --outfile dist/cli.js",
		"check:type": "tsc --noEmit",
		"check:lint": "biome check",
		"test": "bun -b vitest run",
		"dev": "tsdown --watch"
	},
	"devDependencies": {
		"@effect/platform-bun": "^4.0.0-rc.111",
		"@effect/vitest": "^4.0.0-rc.111",
		"@orpc/client": "^1.13.2",
		"@types/bun": "^1.3.2",
		"@types/cli-progress": "^3.11.6",
		"cli-progress": "^3.12.0",
		"ff-effect": "workspace:^",
		"inquirer": "^12.10.0",
		"postgres": "^3.4.7",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.0"
	},
	"peerDependencies": {
		"effect": "^4.0.0-rc.111",
		"@effect/opentelemetry": "^4.0.0-rc.111",
		"get-port": "^7",
		"@orpc/server": "^1",
		"ioredis": "^5"
	},
	"peerDependenciesMeta": {
		"ioredis": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://github.com/fdarian/ff.git",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fdarian/ff.git"
	},
	"bugs": {
		"url": "https://github.com/fdarian/ff/issues"
	},
	"keywords": [
		"effect",
		"server",
		"service"
	],
	"dependencies": {
		"nanoid": "^5.1.6"
	}
}
