{
	"name": "@repo/root",
	"scripts": {
		"changeset": "changeset",
		"ci:version": "changeset version && pnpm install --no-frozen-lockfile",
		"ci:release": "bun scripts/prepare-package-json.ts && bun run build && bun scripts/patch-exports.ts && changeset publish",
		"build": "turbo run build",
		"format": "biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.4",
		"@changesets/cli": "^2.29.7",
		"turbo": "^2.8.9"
	},
	"packageManager": "pnpm@12.0.0",
	"devEngines": {
		"runtime": {
			"name": "bun",
			"version": "latest",
			"onFail": "download"
		}
	}
}
